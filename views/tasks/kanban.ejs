
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= project.name %> | Kanban</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

       body{
    background:#f8f9fa;
}

.board-container{
    overflow-x:auto;
    padding-bottom:10px;
}

.board-column{
    min-height:620px;
    background:white;
    border-radius:18px;
    padding:16px;
    border:1px solid #dee2e6;
    transition:.25s ease;
    display:flex;
    flex-direction:column;
}

.board-column.drag-over{
    background:#eef6ff;
    border:2px dashed #0d6efd;
    transform:scale(1.01);
}

.column-title{
    position:sticky;
    top:0;
    z-index:5;
    background:white;
    padding-bottom:10px;
    margin-bottom:12px;
}

.column-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.column-actions{
    display:flex;
    gap:8px;
    align-items:center;
}

.task-list{
    flex:1;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.task-card{
    cursor:grab;
    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

.task-card:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 24px rgba(0,0,0,.12);
}

.task-card.dragging{
    opacity:.45;
    transform:rotate(3deg);
}

.task-count{
    font-size:.85rem;
}

.avatar-circle{
    width:34px;
    height:34px;
    border-radius:50%;
    background:#0d6efd;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:12px;
    font-weight:700;
    flex-shrink:0;
}

.task-actions{
    display:flex;
    gap:4px;
    opacity:0;
    transition:opacity .15s ease;
}

.task-card:hover .task-actions{
    opacity:1;
}

.task-actions .btn{
    padding:.15rem .35rem;
    line-height:1;
}

.column-progress{
    height:6px;
    border-radius:999px;
    background:#e9ecef;
    overflow:hidden;
    margin-top:10px;
}

.column-progress-fill{
    height:100%;
    width:0%;
    transition:.35s ease;
}

.progress-todo{
    background:#6c757d;
}

.progress-progress{
    background:#0d6efd;
}

.progress-review{
    background:#ffc107;
}

.progress-done{
    background:#198754;
}

.empty-column{
    text-align:center;
    color:#6c757d;
    padding:40px 10px;
    display:none;
}

.empty-column .icon{
    font-size:2rem;
    display:block;
    margin-bottom:10px;
}

@media (max-width:992px){

    .board-row{
        flex-wrap:nowrap;
        overflow-x:auto;
    }

    .board-row>.col-lg-3{
        min-width:320px;
    }

}

    </style>

</head>


