<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Project | TeamFlow</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <div class="auth-container">

        <div class="auth-card">

            <h1>Create Project</h1>

            <p>
                Organization:
                <strong>
                    <%= organization.name %>
                </strong>
            </p>


            <form
                action="/projects/create"
                method="POST"
            >

                <div class="form-group">

                    <label for="name">
                        Project Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Example: E-commerce Website"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        placeholder="Describe your project..."
                    ></textarea>

                </div>


                <button type="submit">
                    Create Project
                </button>

            </form>


            <p class="auth-footer">

                <a href="/projects">
                    Back to Projects
                </a>

            </p>

        </div>

    </div>

</body>

</html>