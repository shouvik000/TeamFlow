<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Dashboard | TeamFlow
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        .realtime-status {
            display: none;
            margin-bottom: 20px;
        }

        .stat-card {
            transition: transform 0.2s ease;
        }

        .stat-card.updated {
            animation: statPulse 0.6s ease;
        }

        @keyframes statPulse {

            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.03);
            }

            100% {
                transform: scale(1);
            }

        }

    </style>

</head>


<body class="bg-light">


    <!-- 
         NAVBAR
     -->

    <nav class="navbar navbar-dark bg-dark shadow-sm">

        <div class="container">

            <a
                class="navbar-brand fw-bold"
                href="/dashboard"
            >
                TeamFlow 🚀
            </a>


            <div class="d-flex align-items-center gap-3">

                <span class="text-white">

                    <%= user.name %>

                </span>


                <!-- Notifications -->

                <a
                    href="/notifications"
                    class="btn btn-outline-light btn-sm position-relative"
                >

                    🔔
                    Notifications


                    <span
                        id="notificationBadge"
                        class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                        style="display: none;"
                    >
                        0
                    </span>

                </a>


                <!-- Logout -->

                <form
                    action="/auth/logout"
                    method="POST"
                    class="m-0"
                >

                    <button
                        type="submit"
                        class="btn btn-danger btn-sm"
                    >
                        Logout
                    </button>

                </form>

            </div>

        </div>

    </nav>


    <!--
         MAIN CONTENT
    -->

    <main class="container py-5">


        <!-- 
             WELCOME
        -->

        <div class="mb-4">

            <h1 class="fw-bold">
                Dashboard
            </h1>


            <p class="text-muted mb-0">

                Welcome back,

                <strong>
                    <%= user.name %>
                </strong>

            </p>

        </div>


        <!-- 
             REAL-TIME STATUS
        -->

        <div
            id="realtimeStatus"
            class="alert alert-success realtime-status"
            role="alert"
        >
            Real-time dashboard updates enabled.
        </div>


        <!--
             ORGANIZATION INFO
         -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3 mb-md-0">

                        <small class="text-muted">
                            Email
                        </small>

                        <div class="fw-semibold">

                            <%= user.email %>

                        </div>

                    </div>


                    <div class="col-md-4 mb-3 mb-md-0">

                        <small class="text-muted">
                            Organization
                        </small>

                        <div class="fw-semibold">

                            <%= user.organizationName %>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted">
                            Role
                        </small>

                        <div>

                            <span class="badge bg-primary">

                                <%= user.role %>

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- 
             STATISTICS
         -->

        <div class="row g-4 mb-5">


            <div class="col-md-6 col-xl-3">

                <div
                    id="projectStatCard"
                    class="card border-0 shadow-sm h-100 stat-card"
                >

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Projects
                        </div>

                        <h2
                            id="projectCount"
                            class="fw-bold mb-0"
                        >
                            <%= projectCount %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-xl-3">

                <div
                    id="taskStatCard"
                    class="card border-0 shadow-sm h-100 stat-card"
                >

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Total Tasks
                        </div>

                        <h2
                            id="taskCount"
                            class="fw-bold mb-0"
                        >
                            <%= taskCount %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-xl-3">

                <div
                    id="completedStatCard"
                    class="card border-0 shadow-sm h-100 stat-card"
                >

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Completed
                        </div>

                        <h2
                            id="completedCount"
                            class="fw-bold mb-0"
                        >
                            <%= completedCount %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-6 col-xl-3">

                <div
                    id="memberStatCard"
                    class="card border-0 shadow-sm h-100 stat-card"
                >

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Team Members
                        </div>

                        <h2
                            id="memberCount"
                            class="fw-bold mb-0"
                        >
                            <%= memberCount %>
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!--
             TASK OVERVIEW
        -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h4 class="fw-bold mb-0">
                        Task Overview
                    </h4>


                    <a
                        href="/projects"
                        class="btn btn-primary btn-sm"
                    >
                        View Projects
                    </a>

                </div>


                <div
                    id="taskOverview"
                    class="row g-3"
                >

                    <% if (
                        taskStatuses &&
                        taskStatuses.length > 0
                    ) { %>


                        <% taskStatuses.forEach(
                            function(item)
                        { %>


                            <div class="col-md-6 col-lg-3">

                                <div class="border rounded p-3 bg-light">

                                    <div class="text-muted small mb-1">

                                        <%= item.status %>

                                    </div>


                                    <div
                                        class="fs-3 fw-bold task-status-count"
                                        data-status="<%= item.status %>"
                                    >

                                        <%= item.count %>

                                    </div>

                                </div>

                            </div>


                        <% }); %>


                    <% } else { %>


                        <div
                            id="noTaskOverview"
                            class="col-12"
                        >

                            <div class="text-center py-4">

                                <p class="text-muted mb-0">

                                    No tasks available yet.

                                </p>

                            </div>

                        </div>


                    <% } %>

                </div>

            </div>

        </div>


        <!--
             PENDING INVITATIONS
        -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body">

                <h4 class="fw-bold mb-4">
                    Pending Invitations
                </h4>


                <% if (
                    invitations &&
                    invitations.length > 0
                ) { %>


                    <% invitations.forEach(
                        function(invitation)
                    { %>


                        <div class="border rounded p-3 mb-3">

                            <div class="row align-items-center">

                                <div class="col-md-8">

                                    <h5 class="mb-2">

                                        <%= invitation.organization_name %>

                                    </h5>


                                    <p class="text-muted mb-1">

                                        You've been invited
                                        to join this organization.

                                    </p>


                                    <div class="small">

                                        <strong>
                                            Email:
                                        </strong>

                                        <%= invitation.email %>


                                        <br>


                                        <strong>
                                            Role:
                                        </strong>


                                        <span class="badge bg-secondary">

                                            <%= invitation.role %>

                                        </span>


                                        <br>


                                        <strong>
                                            Expires:
                                        </strong>

                                        <%= new Date(
                                            invitation.expires_at
                                        ).toLocaleString() %>

                                    </div>

                                </div>


                                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                                    <form
                                        action="/organizations/invite/accept"
                                        method="POST"
                                    >

                                        <input
                                            type="hidden"
                                            name="invitationId"
                                            value="<%= invitation.id %>"
                                        >


                                        <button
                                            type="submit"
                                            class="btn btn-success"
                                        >
                                            Accept Invitation
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>


                    <% }); %>


                <% } else { %>


                    <p class="text-muted mb-0">

                        You don't have any
                        pending invitations.

                    </p>


                <% } %>

            </div>

        </div>


        <!--
             QUICK ACTIONS
         -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body">

                <h4 class="fw-bold mb-4">
                    Quick Actions
                </h4>


                <div class="row g-3">


                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/projects"
                            class="btn btn-outline-primary w-100"
                        >
                            📁 Projects
                        </a>

                    </div>


                    <% if (
                        user.role === "OWNER" ||
                        user.role === "ADMIN"
                    ) { %>


                        <div class="col-md-6 col-lg-3">

                            <a
                                href="/organizations/members"
                                class="btn btn-outline-primary w-100"
                            >
                                👥 Team Members
                            </a>

                        </div>


                    <% } %>


                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/organizations/activity"
                            class="btn btn-outline-primary w-100"
                        >
                            📋 Activity Log
                        </a>

                    </div>


                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/billing/plans"
                            class="btn btn-outline-primary w-100"
                        >
                            💳 Subscription
                        </a>

                    </div>


                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/organizations/switch"
                            class="btn btn-outline-secondary w-100"
                        >
                            🔄 Switch Organization
                        </a>

                    </div>


                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/notifications"
                            class="btn btn-outline-secondary w-100"
                        >
                            🔔 Notifications
                        </a>

                    </div>


                </div>

            </div>

        </div>

    </main>


    <!--
         FOOTER
     -->

    <footer class="border-top bg-white py-3">

        <div class="container text-center">

            <small class="text-muted">
                TeamFlow SaaS Platform
            </small>

        </div>

    </footer>


    <!--
         BOOTSTRAP JS
     -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


    <!-- 
         SOCKET.IO CLIENT
    -->

    <script
        src="/socket.io/socket.io.js"
    ></script>


    <!-- 
         TEAMFLOW NOTIFICATIONS
    -->

    <script
        src="/js/notifications.js"
    ></script>


    <!-- 
         REAL-TIME DASHBOARD
     -->

    <script>

        
        // Socket connection
        

        const dashboardSocket =
            io();


       
        // Elements
        

        const realtimeStatus =
            document.getElementById(
                "realtimeStatus"
            );


        const projectCountElement =
            document.getElementById(
                "projectCount"
            );


        const taskCountElement =
            document.getElementById(
                "taskCount"
            );


        const completedCountElement =
            document.getElementById(
                "completedCount"
            );


        const memberCountElement =
            document.getElementById(
                "memberCount"
            );


        const taskOverviewElement =
            document.getElementById(
                "taskOverview"
            );


        
        // Show realtime message
        

        function showRealtimeStatus(
            message
        ) {

            if (!realtimeStatus) {

                return;

            }


            realtimeStatus.textContent =
                message;


            realtimeStatus.style.display =
                "block";


            setTimeout(
                () => {

                    realtimeStatus.style.display =
                        "none";

                },
                2500
            );

        }


        
        // Animate statistic card
        

        function pulseCard(
            element
        ) {

            if (!element) {

                return;

            }


            element.classList.remove(
                "updated"
            );


            void element.offsetWidth;


            element.classList.add(
                "updated"
            );

        }


        
        // Update task overview
        

        function updateTaskOverview(
            statuses
        ) {

            if (!taskOverviewElement) {

                return;

            }


            if (
                !statuses ||
                statuses.length === 0
            ) {

                taskOverviewElement.innerHTML = `

                    <div
                        id="noTaskOverview"
                        class="col-12"
                    >

                        <div class="text-center py-4">

                            <p class="text-muted mb-0">

                                No tasks available yet.

                            </p>

                        </div>

                    </div>

                `;

                return;

            }


            taskOverviewElement.innerHTML =
                statuses
                    .map(
                        (item) => {

                            return `

                                <div class="col-md-6 col-lg-3">

                                    <div class="border rounded p-3 bg-light">

                                        <div class="text-muted small mb-1">

                                            ${escapeHtml(
                                                item.status
                                            )}

                                        </div>

                                        <div class="fs-3 fw-bold">

                                            ${Number(
                                                item.count
                                            ) || 0}

                                        </div>

                                    </div>

                                </div>

                            `;

                        }
                    )
                    .join("");

        }


        
        // Escape HTML
        

        function escapeHtml(
            value
        ) {

            if (
                value === null ||
                value === undefined
            ) {

                return "";

            }


            return String(value)
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

        }


        
        // Load dashboard statistics
       

        async function loadDashboardStats() {

            try {

                const response =
                    await fetch(
                        "/dashboard/stats",
                        {
                            method: "GET",
                            headers: {
                                "Accept":
                                    "application/json"
                            },
                            credentials:
                                "same-origin"
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        `Dashboard stats request failed: ${response.status}`
                    );

                }


                const data =
                    await response.json();


                if (
                    !data.success
                ) {

                    throw new Error(
                        data.message ||
                        "Failed to load dashboard statistics"
                    );

                }


               
                // Update main statistics
                

                if (
                    projectCountElement
                ) {

                    projectCountElement.textContent =
                        data.stats.projectCount;

                    pulseCard(
                        document.getElementById(
                            "projectStatCard"
                        )
                    );

                }


                if (
                    taskCountElement
                ) {

                    taskCountElement.textContent =
                        data.stats.taskCount;

                    pulseCard(
                        document.getElementById(
                            "taskStatCard"
                        )
                    );

                }


                if (
                    completedCountElement
                ) {

                    completedCountElement.textContent =
                        data.stats.completedCount;

                    pulseCard(
                        document.getElementById(
                            "completedStatCard"
                        )
                    );

                }


                if (
                    memberCountElement
                ) {

                    memberCountElement.textContent =
                        data.stats.memberCount;

                }


                
                // Update task status overview
                

                updateTaskOverview(
                    data.stats.taskStatuses
                );


            } catch (error) {

                console.error(
                    "Dashboard stats error:",
                    error
                );

            }

        }


      
        // Socket connected
        

        dashboardSocket.on(
            "connect",

            () => {

                console.log(
                    "🔌 Dashboard Socket.IO connected"
                );

                showRealtimeStatus(
                    "Real-time dashboard updates connected"
                );

            }
        );


        
        // Socket error
        

        dashboardSocket.on(
            "connect_error",

            (error) => {

                console.error(
                    "Dashboard Socket.IO error:",
                    error
                );

            }
        );


        
        // Task created
        

        dashboardSocket.on(
            "task:created",

            async () => {

                console.log(
                    "📊 Dashboard refresh: task created"
                );


                await loadDashboardStats();


                showRealtimeStatus(
                    "Dashboard updated: new task created"
                );

            }
        );


        // Task updated
        

        dashboardSocket.on(
            "task:updated",

            async () => {

                console.log(
                    "📊 Dashboard refresh: task updated"
                );


                await loadDashboardStats();


                showRealtimeStatus(
                    "Dashboard updated: task changed"
                );

            }
        );


        
        // Task deleted
       

        dashboardSocket.on(
            "task:deleted",

            async () => {

                console.log(
                    "📊 Dashboard refresh: task deleted"
                );


                await loadDashboardStats();


                showRealtimeStatus(
                    "Dashboard updated: task deleted"
                );

            }
        );


       
        // Project created
        

        dashboardSocket.on(
            "project:created",

            async () => {

                console.log(
                    "📊 Dashboard refresh: project created"
                );


                await loadDashboardStats();


                showRealtimeStatus(
                    "Dashboard updated: new project created"
                );

            }
        );


        //
        // Project updated
        

        dashboardSocket.on(
            "project:updated",

            async () => {

                console.log(
                    "📊 Dashboard refresh: project updated"
                );


                await loadDashboardStats();


                showRealtimeStatus(
                    "Dashboard updated: project changed"
                );

            }
        );


       
        // Project deleted
       

        dashboardSocket.on(
            "project:deleted",

            async () => {

                console.log(
                    "📊 Dashboard refresh: project deleted"
                );


                await loadDashboardStats();


                showRealtimeStatus(
                    "Dashboard updated: project deleted"
                );

            }
        );

    </script>

</body>

</html>