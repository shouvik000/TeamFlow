


<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Switch Organization | TeamFlow
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>


<body class="bg-light">


    <!--
         NAVBAR
    -->

    <nav class="navbar navbar-dark bg-dark shadow-sm">

        <div class="container">

            <a
                href="/dashboard"
                class="navbar-brand fw-bold"
            >
                TeamFlow 🚀
            </a>


            <a
                href="/dashboard"
                class="btn btn-outline-light btn-sm"
            >
                Dashboard
            </a>

        </div>

    </nav>


    <!-- 
         MAIN CONTENT
    -->

    <main class="container py-5">

        <div class="row justify-content-center">

            <div class="col-md-8 col-lg-6">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">


                        <!-- 
                             HEADER
                         -->

                        <div class="text-center mb-4">

                            <div class="fs-1 mb-2">
                                🏢
                            </div>

                            <h1 class="fw-bold">
                                Your Organizations
                            </h1>

                            <p class="text-muted mb-0">
                                Choose the organization you want to work in.
                            </p>

                        </div>


                        <!-- 
                             ORGANIZATION LIST
                        -->

                        <% if (
                            organizations &&
                            organizations.length > 0
                        ) { %>


                            <div
                                id="organizationList"
                                class="d-flex flex-column gap-3"
                            >


                                <% organizations.forEach(
                                    function(organization)
                                { %>


                                    <div
                                        class="border rounded p-3"
                                    >

                                        <div
                                            class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"
                                        >

                                            <div>

                                                <h5 class="fw-bold mb-1">

                                                    <%= organization.name %>

                                                </h5>


                                                <div class="text-muted small">

                                                    Role:

                                                    <span class="badge text-bg-primary">

                                                        <%= organization.role %>

                                                    </span>

                                                </div>

                                            </div>


                                            <!-- 
                                                 SWITCH FORM
                                             -->

                                            <form
                                                action="/organizations/switch"
                                                method="POST"
                                                class="switch-form"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="organizationId"
                                                    value="<%= organization.id %>"
                                                >


                                                <button
                                                    type="submit"
                                                    class="btn btn-primary switch-button"
                                                >

                                                    Switch

                                                </button>

                                            </form>

                                        </div>

                                    </div>


                                <% }); %>


                            </div>


                        <% } else { %>


                            <div class="text-center py-4">

                                <div class="fs-1 mb-3">
                                    🏢
                                </div>

                                <h5 class="fw-bold">
                                    No organizations found
                                </h5>

                                <p class="text-muted">
                                    You don't belong to any organizations yet.
                                </p>

                            </div>


                        <% } %>


                        <!-- 
                             STATUS
                         -->

                        <div
                            id="switchStatus"
                            class="alert alert-info d-none mt-4 mb-0"
                        >
                            Switching organization...
                        </div>


                        <!--
                             BACK
                        -->

                        <div class="text-center mt-4">

                            <a
                                href="/dashboard"
                                class="btn btn-outline-secondary"
                            >
                                ← Back to Dashboard
                            </a>

                        </div>


                    </div>

                </div>

            </div>

        </div>

    </main>


    <!--
         SHARED SOCKET
     -->

    <script src="/socket.io/socket.io.js"></script>

    <script src="/js/notifications.js"></script>


    <!-- Organization Switch Script -->

    <script>

        // ========================================
        // Shared Socket
        // ========================================

        const socket =
            window.teamFlowSocket;


        // ========================================
        // Elements
        // ========================================

        const switchForms =
            document.querySelectorAll(
                ".switch-form"
            );


        const switchStatus =
            document.getElementById(
                "switchStatus"
            );


        // ========================================
        // Handle organization switch
        // ========================================

        switchForms.forEach(
            (form) => {

                form.addEventListener(
                    "submit",
                    () => {

                        const button =
                            form.querySelector(
                                ".switch-button"
                            );


                        if (button) {

                            button.disabled =
                                true;


                            button.textContent =
                                "Switching...";

                        }


                        if (switchStatus) {

                            switchStatus.classList.remove(
                                "d-none"
                            );


                            switchStatus.textContent =
                                "Switching organization...";

                        }

                    }
                );

            }
        );


        
        // Socket connection information
       

        if (socket) {

            socket.on(
                "connect",
                () => {

                    console.log(
                        "🔌 Organization switcher connected to Socket.IO"
                    );

                }
            );

        }

    </script>


    

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


</body>

</html>