<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Dashboard | TeamFlow</title>

    
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>


<body class="bg-light">

    <!-- ============================================
         NAVBAR
    ============================================= -->

    <nav class="navbar navbar-dark bg-dark shadow-sm">

        <div class="container">

            <a
                class="navbar-brand fw-bold"
                href="/dashboard"
            >
                TeamFlow 🚀
            </a>


            <div class="d-flex align-items-center gap-3">

                <span class="text-white">

                    <%= user.name %>

                </span>


                <a
                    href="/notifications"
                    class="btn btn-outline-light btn-sm position-relative"
                >

                    🔔

                    Notifications

                    <span
                        id="notificationBadge"
                        class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                        style="display: none;"
                    >
                        0
                    </span>

                </a>


                <form
                    action="/auth/logout"
                    method="POST"
                    class="m-0"
                >

                    <button
                        type="submit"
                        class="btn btn-danger btn-sm"
                    >
                        Logout
                    </button>

                </form>

            </div>

        </div>

    </nav>


    <!-- ============================================
         MAIN CONTENT
    ============================================= -->

    <main class="container py-5">


        <!-- ========================================
             WELCOME SECTION
        ========================================= -->

        <div class="mb-4">

            <h1 class="fw-bold">
                Dashboard
            </h1>

            <p class="text-muted mb-0">

                Welcome back,

                <strong>
                    <%= user.name %>
                </strong>

            </p>

        </div>


        <!-- ========================================
             ORGANIZATION INFO
        ========================================= -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3 mb-md-0">

                        <small class="text-muted">
                            Email
                        </small>

                        <div class="fw-semibold">
                            <%= user.email %>
                        </div>

                    </div>


                    <div class="col-md-4 mb-3 mb-md-0">

                        <small class="text-muted">
                            Organization
                        </small>

                        <div class="fw-semibold">
                            <%= user.organizationName %>
                        </div>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted">
                            Role
                        </small>

                        <div>

                            <span class="badge bg-primary">

                                <%= user.role %>

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================
             STATISTICS
        ========================================= -->

        <div class="row g-4 mb-5">


            <!-- Projects -->

            <div class="col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Projects
                        </div>

                        <h2 class="fw-bold mb-0">

                            <%= projectCount %>

                        </h2>

                    </div>

                </div>

            </div>


            <!-- Tasks -->

            <div class="col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Total Tasks
                        </div>

                        <h2 class="fw-bold mb-0">

                            <%= taskCount %>

                        </h2>

                    </div>

                </div>

            </div>


            <!-- Completed -->

            <div class="col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Completed
                        </div>

                        <h2 class="fw-bold mb-0">

                            <%= completedCount %>

                        </h2>

                    </div>

                </div>

            </div>


            <!-- Members -->

            <div class="col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted mb-2">
                            Team Members
                        </div>

                        <h2 class="fw-bold mb-0">

                            <%= memberCount %>

                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================
             TASK OVERVIEW
        ========================================= -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h4 class="fw-bold mb-0">
                        Task Overview
                    </h4>

                    <a
                        href="/projects"
                        class="btn btn-primary btn-sm"
                    >
                        View Projects
                    </a>

                </div>


                <% if (
                    taskStatuses &&
                    taskStatuses.length > 0
                ) { %>


                    <div class="row g-3">

                        <% taskStatuses.forEach(function(item) { %>

                            <div class="col-md-6 col-lg-3">

                                <div class="border rounded p-3 bg-light">

                                    <div class="text-muted small mb-1">

                                        <%= item.status %>

                                    </div>

                                    <div class="fs-3 fw-bold">

                                        <%= item.count %>

                                    </div>

                                </div>

                            </div>

                        <% }); %>

                    </div>


                <% } else { %>

                    <div class="text-center py-4">

                        <p class="text-muted mb-0">

                            No tasks available yet.

                        </p>

                    </div>

                <% } %>

            </div>

        </div>


        <!-- ========================================
             PENDING INVITATIONS
        ========================================= -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body">

                <h4 class="fw-bold mb-4">
                    Pending Invitations
                </h4>


                <% if (
                    invitations &&
                    invitations.length > 0
                ) { %>


                    <% invitations.forEach(function(invitation) { %>

                        <div class="border rounded p-3 mb-3">

                            <div class="row align-items-center">

                                <div class="col-md-8">

                                    <h5 class="mb-2">

                                        <%= invitation.organization_name %>

                                    </h5>


                                    <p class="text-muted mb-1">

                                        You've been invited
                                        to join this organization.

                                    </p>


                                    <div class="small">

                                        <strong>
                                            Email:
                                        </strong>

                                        <%= invitation.email %>

                                        <br>

                                        <strong>
                                            Role:
                                        </strong>

                                        <span class="badge bg-secondary">

                                            <%= invitation.role %>

                                        </span>

                                        <br>

                                        <strong>
                                            Expires:
                                        </strong>

                                        <%= new Date(
                                            invitation.expires_at
                                        ).toLocaleString() %>

                                    </div>

                                </div>


                                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                                    <form
                                        action="/organizations/invite/accept"
                                        method="POST"
                                    >

                                        <input
                                            type="hidden"
                                            name="invitationId"
                                            value="<%= invitation.id %>"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-success"
                                        >
                                            Accept Invitation
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    <% }); %>


                <% } else { %>

                    <p class="text-muted mb-0">

                        You don't have any pending invitations.

                    </p>

                <% } %>

            </div>

        </div>


        <!-- ========================================
             QUICK ACTIONS
        ========================================= -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body">

                <h4 class="fw-bold mb-4">
                    Quick Actions
                </h4>


                <div class="row g-3">


                    <!-- Projects -->

                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/projects"
                            class="btn btn-outline-primary w-100"
                        >

                            📁

                            Projects

                        </a>

                    </div>


                    <!-- Team -->

                    <% if (
                        user.role === "OWNER" ||
                        user.role === "ADMIN"
                    ) { %>

                        <div class="col-md-6 col-lg-3">

                            <a
                                href="/organizations/members"
                                class="btn btn-outline-primary w-100"
                            >

                                👥

                                Team Members

                            </a>

                        </div>

                    <% } %>


                    <!-- Activity -->

                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/organizations/activity"
                            class="btn btn-outline-primary w-100"
                        >

                            📋

                            Activity Log

                        </a>

                    </div>


                    <!-- Billing -->

                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/billing/plans"
                            class="btn btn-outline-primary w-100"
                        >

                            💳

                            Subscription

                        </a>

                    </div>


                    <!-- Organization -->

                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/organizations/switch"
                            class="btn btn-outline-secondary w-100"
                        >

                            🔄

                            Switch Organization

                        </a>

                    </div>


                    <!-- Notifications -->

                    <div class="col-md-6 col-lg-3">

                        <a
                            href="/notifications"
                            class="btn btn-outline-secondary w-100"
                        >

                            🔔

                            Notifications

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <!-- ============================================
         FOOTER
    ============================================= -->

    <footer class="border-top bg-white py-3">

        <div class="container text-center">

            <small class="text-muted">

                TeamFlow SaaS Platform

            </small>

        </div>

    </footer>


    <!-- ============================================
         BOOTSTRAP JS
    ============================================= -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


    <!-- ============================================
         NOTIFICATION COUNT
    ============================================= -->

    <script>

        async function loadUnreadNotifications() {

            try {

                const response =
                    await fetch(
                        "/notifications/unread-count"
                    );


                const data =
                    await response.json();


                const badge =
                    document.getElementById(
                        "notificationBadge"
                    );


                if (
                    data.success &&
                    data.count > 0
                ) {

                    badge.textContent =
                        data.count;

                    badge.style.display =
                        "inline-block";

                } else {

                    badge.style.display =
                        "none";

                }

            } catch (error) {

                console.error(
                    "Failed to load notification count:",
                    error
                );

            }

        }


        loadUnreadNotifications();

    </script>


</body>

</html>