<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Dashboard | TeamFlow</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <div class="auth-container">

        <div class="auth-card">

            <h1>TeamFlow 🚀</h1>

            <h2>Dashboard</h2>


            <p>
                Welcome,
                <strong>
                    <%= user.name %>
                </strong>
            </p>


            <p>
                Email:
                <strong>
                    <%= user.email %>
                </strong>
            </p>


            <p>
                Organization:
                <strong>
                    <%= user.organizationName %>
                </strong>
            </p>


            <p>
                Organization ID:
                <strong>
                    <%= user.organizationId %>
                </strong>
            </p>


            <p>
                Role:
                <strong>
                    <%= user.role %>
                </strong>
            </p>


            <form
                action="/auth/logout"
                method="POST"
            >

                <button type="submit">
                    Logout
                </button>

            </form>

        </div>

    </div>

</body>

</html>