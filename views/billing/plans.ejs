<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Plans | TeamFlow
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <script
        src="https://checkout.razorpay.com/v1/checkout.js"
    ></script>

</head>


<body>

    <div class="auth-container">

        <div class="auth-card">

            <h1>
                TeamFlow Plans
            </h1>


            <h2>
                Current Plan
            </h2>

            <p>
                Plan:

                <strong>
                    <%= subscription.plan_name %>
                </strong>
            </p>

            <p>
                Status:

                <strong>
                    <%= subscription.status %>
                </strong>
            </p>


            <hr>


            <h2>
                Current Usage
            </h2>


            <p>

                Projects:

                <strong>
                    <%= usage.project_count %>
                </strong>

                /

                <strong>
                    <%= subscription.max_projects === null
                        ? "Unlimited"
                        : subscription.max_projects %>
                </strong>

            </p>


            <p>

                Members:

                <strong>
                    <%= usage.member_count %>
                </strong>

                /

                <strong>
                    <%= subscription.max_members === null
                        ? "Unlimited"
                        : subscription.max_members %>
                </strong>

            </p>


            <p>

                Tasks:

                <strong>
                    <%= usage.task_count %>
                </strong>

                /

                <strong>
                    <%= subscription.max_tasks === null
                        ? "Unlimited"
                        : subscription.max_tasks %>
                </strong>

            </p>


            <hr>


            <h2>
                Available Plans
            </h2>


            <% plans.forEach(function(plan) { %>

                <div
                    style="
                        border: 1px solid #ddd;
                        padding: 20px;
                        margin-top: 20px;
                        border-radius: 8px;
                    "
                >

                    <h2>
                        <%= plan.name %>
                    </h2>


                    <h3>

                        ₹<%= Number(
                            plan.price_monthly
                        ).toFixed(2) %>

                        / month

                    </h3>


                    <p>

                        Projects:

                        <strong>
                            <%= plan.max_projects === null
                                ? "Unlimited"
                                : plan.max_projects %>
                        </strong>

                    </p>


                    <p>

                        Members:

                        <strong>
                            <%= plan.max_members === null
                                ? "Unlimited"
                                : plan.max_members %>
                        </strong>

                    </p>


                    <p>

                        Tasks:

                        <strong>
                            <%= plan.max_tasks === null
                                ? "Unlimited"
                                : plan.max_tasks %>
                        </strong>

                    </p>


                    <% if (
                        subscription &&
                        subscription.plan_id === plan.id
                    ) { %>

                        <div
                            style="
                                display: inline-block;
                                padding: 10px 16px;
                                border-radius: 6px;
                                background: #e5e7eb;
                                font-weight: bold;
                            "
                        >
                            ✓ Current Plan
                        </div>

                    <% } else if (
                        Number(plan.price_monthly) > 0
                    ) { %>

                        <button
                            type="button"
                            onclick="startPayment(<%= plan.id %>)"
                        >
                            Upgrade
                        </button>

                    <% } %>

                </div>

            <% }); %>


            <p class="auth-footer">

                <a href="/dashboard">
                    ← Dashboard
                </a>

            </p>

        </div>

    </div>


    <script>

        async function startPayment(planId) {

            try {

                // Create order
                const response =
                    await fetch(
                        "/billing/create-order",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                planId: planId
                            })
                        }
                    );


                const data =
                    await response.json();


                if (!data.success) {

                    alert(
                        data.message ||
                        "Could not create payment"
                    );

                    return;

                }


                // Razorpay checkout
                const options = {

                    key: data.keyId,

                    amount: data.amount,

                    currency: data.currency,

                    name: "TeamFlow",

                    description:
                        `${data.planName} Subscription`,

                    order_id:
                        data.orderId,


                    handler: async function (
                        response
                    ) {

                        try {

                            const verifyResponse =
                                await fetch(
                                    "/billing/verify-payment",
                                    {
                                        method: "POST",

                                        headers: {
                                            "Content-Type":
                                                "application/json"
                                        },

                                        body: JSON.stringify(
                                            response
                                        )
                                    }
                                );


                            const verifyData =
                                await verifyResponse.json();


                            if (
                                verifyData.success
                            ) {

                                alert(
                                    "Payment successful! Your plan has been upgraded."
                                );

                                window.location.href =
                                    "/billing/plans";

                            } else {

                                alert(
                                    verifyData.message ||
                                    "Payment verification failed"
                                );

                            }

                        } catch (error) {

                            console.error(
                                error
                            );

                            alert(
                                "Payment verification failed"
                            );

                        }

                    },


                    prefill: {

                        name:
                            "<%= user.name %>",

                        email:
                            "<%= user.email %>"

                    },


                    theme: {

                        color: "#2563eb"

                    }

                };


                const razorpay =
                    new Razorpay(options);


                razorpay.open();


            } catch (error) {

                console.error(
                    "Payment error:",
                    error
                );

                alert(
                    "Unable to start payment"
                );

            }

        }

    </script>

</body>

</html>