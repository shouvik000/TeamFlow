<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Login | TeamFlow</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <div class="auth-container">

        <div class="auth-card">

            <h1>TeamFlow</h1>

            <h2>Welcome back</h2>

            <p>Login to your workspace.</p>


            <form action="/auth/login" method="POST">

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                    >

                </div>


                <button type="submit">
                    Login
                </button>

            </form>


            <p class="auth-footer">

                Don't have an account?

                <a href="/auth/register">
                    Create account
                </a>

            </p>

        </div>

    </div>

</body>

</html>