<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Dashboard | TeamFlow</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

    <div class="auth-container">

        <div class="auth-card">

            <h1>TeamFlow 🚀</h1>

            <h2>Dashboard</h2>


            <!-- ================================= -->
            <!-- CURRENT USER -->
            <!-- ================================= -->

            <div>

                <p>
                    Welcome,
                    <strong>
                        <%= user.name %>
                    </strong>
                </p>

                <p>
                    Email:
                    <strong>
                        <%= user.email %>
                    </strong>
                </p>

                <p>
                    Current Organization:
                    <strong>
                        <%= user.organizationName %>
                    </strong>
                </p>

                <p>
                    Current Role:
                    <strong>
                        <%= user.role %>
                    </strong>
                </p>

            </div>


            <hr>


            <!-- ================================= -->
            <!-- PENDING INVITATIONS -->
            <!-- ================================= -->

            <h2>
                Pending Invitations
            </h2>


            <% if (
                invitations &&
                invitations.length > 0
            ) { %>


                <% invitations.forEach(invitation => { %>


                    <div
                        style="
                            border: 1px solid #ddd;
                            padding: 15px;
                            margin-top: 15px;
                            border-radius: 8px;
                        "
                    >

                        <h3>
                            <%= invitation.organization_name %>
                        </h3>


                        <p>
                            You've been invited to join
                            this organization.
                        </p>


                        <p>
                            Email:
                            <strong>
                                <%= invitation.email %>
                            </strong>
                        </p>


                        <p>
                            Role:
                            <strong>
                                <%= invitation.role %>
                            </strong>
                        </p>


                        <p>
                            Expires:
                            <%= new Date(
                                invitation.expires_at
                            ).toLocaleString() %>
                        </p>


                        <form
                            action="/organizations/invite/accept"
                            method="POST"
                        >

                            <input
                                type="hidden"
                                name="invitationId"
                                value="<%= invitation.id %>"
                            >


                            <button
                                type="submit"
                            >
                                Accept Invitation
                            </button>

                        </form>

                    </div>


                <% }); %>


            <% } else { %>

                <p>
                    You don't have any pending invitations.
                </p>

            <% } %>


            <hr>


            <!-- ================================= -->
            <!-- NAVIGATION -->
            <!-- ================================= -->

            <p>

                <a href="/projects">
                    Projects
                </a>

            </p>


            <p>

                <% if (
                    user.role === "OWNER" ||
                    user.role === "ADMIN"
                ) { %>

                    <a href="/organizations/members">
                        Team Members
                    </a>

                <% } %>

            </p>


            <!-- ================================= -->
            <!-- LOGOUT -->
            <!-- ================================= -->

            <form
                action="/auth/logout"
                method="POST"
            >

                <button type="submit">
                    Logout
                </button>

            </form>

        </div>

    </div>

</body>

</html>