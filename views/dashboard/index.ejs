<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Dashboard | TeamFlow
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        /* ============================================
           Dashboard statistics
        ============================================ */

        .dashboard-stats {

            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(180px, 1fr)
                );

            gap: 15px;

            margin-top: 20px;

            margin-bottom: 30px;
        }


        .stat-card {

            border: 1px solid #ddd;

            border-radius: 10px;

            padding: 20px;

            background: #ffffff;

            text-align: center;
        }


        .stat-card h3 {

            margin-bottom: 10px;

            font-size: 16px;

        }


        .stat-number {

            font-size: 32px;

            font-weight: bold;

            margin: 0;
        }


        /* ============================================
           Task status section
        ============================================ */

        .task-status-list {

            margin-top: 20px;
        }


        .task-status-item {

            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 12px 15px;

            border: 1px solid #ddd;

            border-radius: 8px;

            margin-top: 10px;

            background: #ffffff;
        }


        .task-status-count {

            font-weight: bold;

        }


        /* ============================================
           Invitations
        ============================================ */

        .invitation-card {

            border: 1px solid #ddd;

            padding: 15px;

            margin-top: 15px;

            border-radius: 8px;

        }

    </style>

</head>


<body>

    <div class="auth-container">

        <div class="auth-card">

            <!-- ================================= -->
            <!-- HEADER -->
            <!-- ================================= -->

            <h1>
                TeamFlow 🚀
            </h1>

            <h2>
                Dashboard
            </h2>


            <!-- ================================= -->
            <!-- CURRENT USER -->
            <!-- ================================= -->

            <div>

                <p>

                    Welcome,

                    <strong>
                        <%= user.name %>
                    </strong>

                </p>


                <p>

                    Email:

                    <strong>
                        <%= user.email %>
                    </strong>

                </p>


                <p>

                    Current Organization:

                    <strong>
                        <%= user.organizationName %>
                    </strong>

                </p>


                <p>

                    Current Role:

                    <strong>
                        <%= user.role %>
                    </strong>

                </p>

            </div>


            <hr>


            <!-- ================================= -->
            <!-- DASHBOARD STATISTICS -->
            <!-- ================================= -->

            <h2>
                Organization Overview
            </h2>


            <div class="dashboard-stats">


                <!-- Projects -->

                <div class="stat-card">

                    <h3>
                        Projects
                    </h3>

                    <p class="stat-number">
                        <%= projectCount %>
                    </p>

                </div>


                <!-- Tasks -->

                <div class="stat-card">

                    <h3>
                        Total Tasks
                    </h3>

                    <p class="stat-number">
                        <%= taskCount %>
                    </p>

                </div>


                <!-- Completed -->

                <div class="stat-card">

                    <h3>
                        Completed
                    </h3>

                    <p class="stat-number">
                        <%= completedCount %>
                    </p>

                </div>


                <!-- Members -->

                <div class="stat-card">

                    <h3>
                        Team Members
                    </h3>

                    <p class="stat-number">
                        <%= memberCount %>
                    </p>

                </div>


            </div>


            <!-- ================================= -->
            <!-- TASK STATUS -->
            <!-- ================================= -->

            <h2>
                Task Overview
            </h2>


            <div class="task-status-list">

                <% if (
                    taskStatuses &&
                    taskStatuses.length > 0
                ) { %>


                    <% taskStatuses.forEach(function(item) { %>

                        <div class="task-status-item">

                            <span>

                                <%= item.status %>

                            </span>


                            <span class="task-status-count">

                                <%= item.count %>

                            </span>

                        </div>

                    <% }); %>


                <% } else { %>

                    <p>
                        No tasks available.
                    </p>

                <% } %>

            </div>


            <hr>


            <!-- ================================= -->
            <!-- PENDING INVITATIONS -->
            <!-- ================================= -->

            <h2>
                Pending Invitations
            </h2>


            <% if (

                invitations &&
                invitations.length > 0

            ) { %>


                <% invitations.forEach(
                    invitation => {
                %>


                    <div class="invitation-card">


                        <h3>

                            <%= invitation.organization_name %>

                        </h3>


                        <p>

                            You've been invited
                            to join this organization.

                        </p>


                        <p>

                            Email:

                            <strong>

                                <%= invitation.email %>

                            </strong>

                        </p>


                        <p>

                            Role:

                            <strong>

                                <%= invitation.role %>

                            </strong>

                        </p>


                        <p>

                            Expires:

                            <%= new Date(
                                invitation.expires_at
                            ).toLocaleString() %>

                        </p>


                        <form

                            action=
                            "/organizations/invite/accept"

                            method="POST"

                        >

                            <input

                                type="hidden"

                                name="invitationId"

                                value=
                                "<%= invitation.id %>"

                            >


                            <button
                                type="submit"
                            >

                                Accept Invitation

                            </button>

                        </form>


                    </div>


                <% }); %>


            <% } else { %>


                <p>

                    You don't have any
                    pending invitations.

                </p>


            <% } %>


            <hr>


            <!-- ================================= -->
            <!-- NAVIGATION -->
            <!-- ================================= -->

            <p>

                <a href="/projects">

                    Projects

                </a>

            </p>


            <% if (

                user.role === "OWNER" ||

                user.role === "ADMIN"

            ) { %>


                <p>

                    <a href="/organizations/members">

                        Team Members

                    </a>

                </p>


            <% } %>


            <p>

                <a href="/organizations/activity">

                    Activity Log

                </a>

            </p>


            <p>

                <a href="/billing/plans">

                    Subscription & Plans

                </a>

            </p>


            <p>

                <a href="/organizations/switch">

                    Switch Organization

                </a>

            </p>


            <!-- ================================= -->
            <!-- NOTIFICATIONS -->
            <!-- ================================= -->

            <p>

                <a href="/notifications">

                    🔔 Notifications

                    <span
                        id="notificationBadge"

                        style="
                            display: none;
                            background: red;
                            color: white;
                            padding: 2px 7px;
                            border-radius: 10px;
                            font-size: 12px;
                        "
                    >

                        0

                    </span>

                </a>

            </p>


            <!-- ================================= -->
            <!-- LOGOUT -->
            <!-- ================================= -->

            <form

                action="/auth/logout"

                method="POST"

            >

                <button
                    type="submit"
                >

                    Logout

                </button>

            </form>


        </div>

    </div>



    <!-- ============================================
         Notification Count Script
    ============================================= -->

    <script>

        async function loadUnreadNotifications() {

            try {

                const response =
                    await fetch(
                        "/notifications/unread-count"
                    );


                const data =
                    await response.json();


                const badge =
                    document.getElementById(
                        "notificationBadge"
                    );


                if (

                    data.success &&

                    data.count > 0

                ) {

                    badge.textContent =
                        data.count;


                    badge.style.display =
                        "inline-block";


                } else {

                    badge.style.display =
                        "none";

                }


            } catch (error) {

                console.error(
                    "Failed to load notification count:",
                    error
                );

            }

        }


        // Load notification count
        loadUnreadNotifications();

    </script>


</body>

</html>