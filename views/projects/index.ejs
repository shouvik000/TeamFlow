<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Projects | TeamFlow</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>
        body {
            background: #f8f9fa;
        }

        .project-card {
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .project-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.1);
        }

        .realtime-status {
            display: none;
        }

        .project-status {
            font-weight: 600;
        }

        .empty-projects {
            text-align: center;
            padding: 40px 20px;
            color: #6c757d;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-dark bg-dark shadow-sm">
    <div class="container">

        <a
            class="navbar-brand fw-bold"
            href="/dashboard"
        >
            TeamFlow 🚀
        </a>

        <span class="text-white">
            <%= organization.name %>
        </span>

    </div>
</nav>

<main class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Projects</h2>

            <p class="text-muted mb-0">
                Total Projects:
                <strong id="projectCount"><%= projects.length %></strong>
            </p>
        </div>

        <a
            href="/projects/create"
            class="btn btn-primary"
        >
            + Create Project
        </a>

    </div>

    <div
        id="realtimeStatus"
        class="alert alert-success realtime-status"
    ></div>

    <div
        id="projectList"
        class="row g-4"
    >

        <% if (projects.length === 0) { %>

            <div
                class="col-12"
                id="emptyProjectsMessage"
            >
                <div class="card border-0 shadow-sm">
                    <div class="card-body empty-projects">
                        <h5>No projects created yet.</h5>
                        <p>Create your first project to get started.</p>
                    </div>
                </div>
            </div>

        <% } %>

        <% projects.forEach(project => { %>

            <div
                class="col-md-6 col-lg-4 project-card-wrapper"
                id="project-<%= project.id %>"
                data-project-id="<%= project.id %>"
            >

                <div class="card project-card border-0 shadow-sm h-100">

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-3">

                            <h5 class="project-name fw-bold mb-0">
                                <%= project.name %>
                            </h5>

                            <span class="badge bg-primary">
                                #<%= project.id %>
                            </span>

                        </div>

                        <p class="project-description text-muted flex-grow-1">
                            <%= project.description || "No description." %>
                        </p>

                        <div class="mb-3">

                            <div class="small text-muted">
                                Status
                            </div>

                            <div class="project-status">
                                <%= project.status %>
                            </div>

                        </div>

                        <div class="mb-3">

                            <div class="small text-muted">
                                Created by
                            </div>

                            <div class="project-creator">
                                <%= project.created_by_name || "Unknown" %>
                            </div>

                        </div>

                        <div class="d-grid gap-2 mt-auto">

                            <a
                                href="/projects/<%= project.id %>/tasks"
                                class="btn btn-outline-primary btn-sm"
                            >
                                📋 View Tasks
                            </a>

                            <a
                                href="/kanban/project/<%= project.id %>"
                                class="btn btn-primary btn-sm"
                            >
                                🗂 Kanban Board
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

    <div class="mt-4">

        <a
            href="/dashboard"
            class="btn btn-outline-secondary"
        >
            ← Back to Dashboard
        </a>

    </div>

</main>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/notifications.js"></script>

<script>

    // ===================================================
    // Use shared TeamFlow Socket
    // ===================================================

    const socket = window.teamFlowSocket;

    const projectList =
        document.getElementById("projectList");

    const projectCount =
        document.getElementById("projectCount");

    const realtimeStatus =
        document.getElementById("realtimeStatus");

    function showRealtimeStatus(message){

        realtimeStatus.textContent = message;

        realtimeStatus.style.display = "block";

        setTimeout(() => {

            realtimeStatus.style.display = "none";

        },3000);

    }

    function escapeHtml(value){

        return String(value ?? "")
            .replace(/&/g,"&amp;")
            .replace(/</g,"&lt;")
            .replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;")
            .replace(/'/g,"&#039;");

    }

    function updateProjectCount(){

        projectCount.textContent =
            document.querySelectorAll(".project-card-wrapper").length;

    }

    function removeEmptyMessage(){

        document.getElementById("emptyProjectsMessage")?.remove();

    }

    function showEmptyMessage(){

        if(document.getElementById("emptyProjectsMessage")) return;

        const col=document.createElement("div");

        col.className="col-12";
        col.id="emptyProjectsMessage";

        col.innerHTML=`
            <div class="card border-0 shadow-sm">
                <div class="card-body empty-projects">
                    <h5>No projects created yet.</h5>
                </div>
            </div>
        `;

        projectList.appendChild(col);

    }

    function createProjectCard(project){

        const col=document.createElement("div");

        col.className="col-md-6 col-lg-4 project-card-wrapper";

        col.id=`project-${project.id}`;

        col.dataset.projectId=project.id;

        col.innerHTML=`
            <div class="card project-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <h5 class="project-name fw-bold mb-0">
                            ${escapeHtml(project.name)}
                        </h5>

                        <span class="badge bg-primary">
                            #${project.id}
                        </span>

                    </div>

                    <p class="project-description text-muted flex-grow-1">
                        ${escapeHtml(project.description || "No description.")}
                    </p>

                    <div class="mb-3">

                        <div class="small text-muted">Status</div>

                        <div class="project-status">
                            ${escapeHtml(project.status || "ACTIVE")}
                        </div>

                    </div>

                    <div class="mb-3">

                        <div class="small text-muted">Created by</div>

                        <div class="project-creator">
                            ${escapeHtml(project.created_by_name || "Unknown")}
                        </div>

                    </div>

                    <div class="d-grid gap-2 mt-auto">

                        <a
                            href="/projects/${project.id}/tasks"
                            class="btn btn-outline-primary btn-sm"
                        >
                            📋 View Tasks
                        </a>

                        <a
                            href="/kanban/project/${project.id}"
                            class="btn btn-primary btn-sm"
                        >
                            🗂 Kanban Board
                        </a>

                    </div>

                </div>
            </div>
        `;

        return col;

    }

    if(socket){

        socket.on("connect",()=>{

            console.log("Connected to TeamFlow socket");

            showRealtimeStatus("Real-time project updates connected");

        });

        socket.on("project:created",(project)=>{

            if(document.getElementById(`project-${project.id}`)) return;

            removeEmptyMessage();

            projectList.prepend(createProjectCard(project));

            updateProjectCount();

            showRealtimeStatus("Project created");

        });

        socket.on("project:updated",(project)=>{

            const existing=document.getElementById(`project-${project.id}`);

            if(!existing){

                removeEmptyMessage();

                projectList.prepend(createProjectCard(project));

                updateProjectCount();

                return;

            }

            const replacement=createProjectCard(project);

            existing.replaceWith(replacement);

            showRealtimeStatus("Project updated");

        });

        socket.on("project:deleted",(project)=>{

            document.getElementById(`project-${project.id}`)?.remove();

            updateProjectCount();

            if(document.querySelectorAll(".project-card-wrapper").length===0){

                showEmptyMessage();

            }

            showRealtimeStatus("Project deleted");

        });

    }

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>