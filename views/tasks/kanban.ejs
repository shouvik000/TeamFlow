
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= project.name %> | Kanban</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

       body{
    background:#f8f9fa;
}

.board-column{
    min-height:620px;
    background:white;
    border-radius:18px;
    padding:16px;
    border:1px solid #dee2e6;
    transition:.25s ease;
    display:flex;
    flex-direction:column;
}

.board-column.drag-over{
    background:#eef6ff;
    border:2px dashed #0d6efd;
    transform:scale(1.01);
}

.column-title{
    position:sticky;
    top:0;
    z-index:5;
    background:white;
    padding-bottom:10px;
    margin-bottom:12px;
}

.column-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.column-actions{
    display:flex;
    gap:8px;
    align-items:center;
}

.task-list{
    flex:1;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.task-card{
    cursor:grab;
    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

.task-card:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 24px rgba(0,0,0,.12);
}

.task-card.dragging{
    opacity:.45;
    transform:rotate(3deg);
}

.task-card.saving{
    opacity:.6;
    pointer-events:none;
    position:relative;
}

.task-card.saving::after{
    content:"Saving...";
    position:absolute;
    inset:0;
    background:rgba(255,255,255,.75);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:.85rem;
    font-weight:600;
}

.task-count{
    font-size:.85rem;
}

.avatar-circle{
    width:34px;
    height:34px;
    border-radius:50%;
    background:#0d6efd;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:12px;
    font-weight:700;
    flex-shrink:0;
}

.task-actions{
    display:flex;
    gap:4px;
    opacity:0;
    transition:opacity .15s ease;
}

.task-card:hover .task-actions{
    opacity:1;
}

.task-actions .btn{
    padding:.15rem .35rem;
    line-height:1;
}

.column-progress{
    height:6px;
    border-radius:999px;
    background:#e9ecef;
    overflow:hidden;
    margin-top:10px;
}

.column-progress-fill{
    height:100%;
    width:0%;
    transition:.35s ease;
}

.progress-todo{
    background:#6c757d;
}

.progress-progress{
    background:#0d6efd;
}

.progress-review{
    background:#ffc107;
}

.progress-done{
    background:#198754;
}

.empty-column{
    text-align:center;
    color:#6c757d;
    padding:40px 10px;
    display:none;
}

.empty-column .icon{
    font-size:2rem;
    display:block;
    margin-bottom:10px;
}

@media (max-width:992px){

    .board-row{
        flex-wrap:nowrap;
        overflow-x:auto;
    }

    .board-row>.col-lg-3{
        min-width:320px;
    }

}

.editable-title{
    cursor:text;
    border-radius:4px;
    transition:background .2s;
}

.editable-title:hover{
    background:#eef6ff;
}



    </style>

</head>


<body
 data-organization-id="<%= organization.id %>"
    data-project-id="<%= project.id %>"
>


<!-- ============================================
     NAVBAR
============================================= -->

<nav class="navbar navbar-dark bg-dark shadow-sm">

    <div class="container">

        <a
            class="navbar-brand fw-bold"
            href="/dashboard"
        >
            TeamFlow 🚀
        </a>

        <span class="text-white">
            <%= project.name %>
        </span>

    </div>

</nav>


<!-- ============================================
     MAIN CONTAINER
============================================= -->

<div class="container-fluid py-4">


    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-0">
                Kanban Board
            </h2>

            <p class="text-muted mb-0">
                Organization: <%= organization.name %>
            </p>

        </div>


        <a
            href="/projects/<%= project.id %>/tasks"
            class="btn btn-outline-primary"
        >
            ← Task List
        </a>



















    </div>













<!-- ===========================================
KANBAN TOOLBAR
=========================================== -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <div class="row g-3 align-items-center">

            <div class="col-lg-4">

                <label class="form-label mb-1">Search</label>

                <input
                    id="kanbanSearch"
                    class="form-control"
                    placeholder="Search title or description..."
                >

            </div>

            <div class="col-lg-3">

                <label class="form-label mb-1">Priority</label>

                <select
                    id="priorityFilter"
                    class="form-select"
                >

                    <option value="">All Priorities</option>
                    <option value="LOW">LOW</option>
                    <option value="MEDIUM">MEDIUM</option>
                    <option value="HIGH">HIGH</option>
                    <option value="URGENT">URGENT</option>

                </select>

            </div>

            <div class="col-lg-3">

                <label class="form-label mb-1">Assignee</label>

                <select
                    id="assigneeFilter"
                    class="form-select"
                >

                    <option value="">All Assignees</option>

                    <% members.forEach(member=>{ %>

                        <option value="<%= member.name %>">
                            <%= member.name %>
                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="col-lg-2">

                <label class="form-label mb-1">Sort</label>

                <select
                    id="sortTasks"
                    class="form-select"
                >

                    <option value="newest">Newest</option>
                    <option value="oldest">Oldest</option>
                    <option value="due">Due Date</option>

                </select>

            </div>

        </div>

    </div>

</div>





































    <!-- ============================================
         KANBAN BOARD
    ============================================= -->

    <div class="row g-3 board-row">


        <!-- ========================================
             TODO
        ========================================= -->

        <div class="col-lg-3">

            <div
                class="board-column"
                data-status="TODO"
            >

                <div class="column-title">

                    <div class="column-header">

                        <h5 class="mb-0">TODO</h5>

                        <div class="column-actions">

                            <span class="badge bg-secondary task-count">
                                <%= todoTasks.length %>
                            </span>

                            <button
                                class="btn btn-sm btn-outline-primary add-task-btn"
                                data-status="TODO"
                                type="button"
                            >
                                +
                            </button>

                        </div>

                    </div>

                    <div class="column-progress">

                        <div
                            class="column-progress-fill progress-todo"
                        ></div>

                    </div>

                </div>


                <div class="task-list">

                    <% todoTasks.forEach(task=>{ %>

                        <div
                            class="task-wrapper"
                            data-task='<%- JSON.stringify(task) %>'
                        >

                            <%- include("kanban-task-card",{task}) %>

                        </div>

                    <% }) %>

                    <div class="empty-column">

                        <span class="icon">📭</span>

                        No tasks yet

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================
             IN PROGRESS
        ========================================= -->

        <div class="col-lg-3">

            <div
                class="board-column"
                data-status="IN_PROGRESS"
            >

                <div class="column-title">

                    <div class="column-header">

                        <h5 class="mb-0">IN PROGRESS</h5>

                        <div class="column-actions">

                            <span class="badge bg-primary task-count">
                                <%= inProgressTasks.length %>
                            </span>

                            <button
                                class="btn btn-sm btn-outline-primary add-task-btn"
                                data-status="IN_PROGRESS"
                                type="button"
                            >
                                +
                            </button>

                        </div>

                    </div>

                    <div class="column-progress">

                        <div
                            class="column-progress-fill progress-progress"
                        ></div>

                    </div>

                </div>


                <div class="task-list">

                    <% inProgressTasks.forEach(task=>{ %>

                        <div
                            class="task-wrapper"
                            data-task='<%- JSON.stringify(task) %>'
                        >

                            <%- include("kanban-task-card",{task}) %>

                        </div>

                    <% }) %>

                    <div class="empty-column">

                        <span class="icon">📭</span>

                        No tasks yet

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================
             REVIEW
        ========================================= -->

        <div class="col-lg-3">

            <div
                class="board-column"
                data-status="REVIEW"
            >

                <div class="column-title">

                    <div class="column-header">

                        <h5 class="mb-0">REVIEW</h5>

                        <div class="column-actions">

                            <span class="badge bg-warning text-dark task-count">
                                <%= reviewTasks.length %>
                            </span>

                            <button
                                class="btn btn-sm btn-outline-primary add-task-btn"
                                data-status="REVIEW"
                                type="button"
                            >
                                +
                            </button>

                        </div>

                    </div>

                    <div class="column-progress">

                        <div
                            class="column-progress-fill progress-review"
                        ></div>

                    </div>

                </div>


                <div class="task-list">

                    <% reviewTasks.forEach(task=>{ %>

                        <div
                            class="task-wrapper"
                            data-task='<%- JSON.stringify(task) %>'
                        >

                            <%- include("kanban-task-card",{task}) %>

                        </div>

                    <% }) %>

                    <div class="empty-column">

                        <span class="icon">📭</span>

                        No tasks yet

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================
             DONE
        ========================================= -->

        <div class="col-lg-3">

            <div
                class="board-column"
                data-status="DONE"
            >

                <div class="column-title">

                    <div class="column-header">

                        <h5 class="mb-0">DONE</h5>

                        <div class="column-actions">

                            <span class="badge bg-success task-count">
                                <%= doneTasks.length %>
                            </span>

                            <button
                                class="btn btn-sm btn-outline-primary add-task-btn"
                                data-status="DONE"
                                type="button"
                            >
                                +
                            </button>

                        </div>

                    </div>

                    <div class="column-progress">

                        <div
                            class="column-progress-fill progress-done"
                        ></div>

                    </div>

                </div>


                <div class="task-list">

                    <% doneTasks.forEach(task=>{ %>

                        <div
                            class="task-wrapper"
                            data-task='<%- JSON.stringify(task) %>'
                        >

                            <%- include("kanban-task-card",{task}) %>

                        </div>

                    <% }) %>

                    <div class="empty-column">

                        <span class="icon">📭</span>

                        No tasks yet

                    </div>

                </div>

            </div>

        </div>


    </div>

</div>


<!-- ============================================
     TASK DETAILS + EDIT MODAL
============================================= -->

<div
    class="modal fade"
    id="taskModal"
    tabindex="-1"
>

    <div class="modal-dialog modal-lg modal-dialog-scrollable">

        <div class="modal-content">


            <div class="modal-header">

                <h5
                    class="modal-title"
                    id="taskModalLabel"
                >
                    Task
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body">

                <form id="editTaskForm">

                    <input
                        type="hidden"
                        id="editTaskId"
                    >


                    <div class="mb-3">

                        <label class="form-label">
                            Title
                        </label>

                        <input
                            class="form-control"
                            id="editTaskTitle"
                            required
                        >

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea
                            class="form-control"
                            id="editTaskDescription"
                            rows="3"
                        ></textarea>

                    </div>


                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Priority
                            </label>

                            <select
                                id="editTaskPriority"
                                class="form-select"
                            >

                                <option value="LOW">
                                    LOW
                                </option>

                                <option value="MEDIUM">
                                    MEDIUM
                                </option>

                                <option value="HIGH">
                                    HIGH
                                </option>

                                <option value="URGENT">
                                    URGENT
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Status
                            </label>

                            <select
                                id="editTaskStatus"
                                class="form-select"
                            >

                                <option value="TODO">
                                    TODO
                                </option>

                                <option value="IN_PROGRESS">
                                    IN PROGRESS
                                </option>

                                <option value="REVIEW">
                                    REVIEW
                                </option>

                                <option value="DONE">
                                    DONE
                                </option>

                            </select>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Due Date
                        </label>

                        <input
                            type="date"
                            id="editTaskDueDate"
                            class="form-control"
                        >

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Assignee
                        </label>

                        <select
                            id="editTaskAssignee"
                            class="form-select"
                        >

                            <option value="">
                                Unassigned
                            </option>

                            <% members.forEach(member => { %>

                                <option value="<%= member.id %>">
                                    <%= member.name %>
                                </option>

                            <% }) %>

                        </select>

                    </div>

                </form>

            </div>


            <div class="modal-footer">


                <a
                    id="openTaskPage"
                    href="#"
                    class="btn btn-outline-primary"
                >
                    Task List
                </a>


                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Close
                </button>


                <button
                    type="button"
                    id="saveTaskButton"
                    class="btn btn-primary"
                >
                    Save Changes
                </button>


            </div>


        </div>

    </div>

</div>


<!-- ============================================
     ADD TASK MODAL
============================================= -->

<div
    class="modal fade"
    id="addTaskModal"
    tabindex="-1"
>

    <div class="modal-dialog">

        <div class="modal-content">


            <form id="kanbanTaskForm">


                <div class="modal-header">

                    <h5 class="modal-title">
                        New Task
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                    ></button>

                </div>


                <div class="modal-body">


                    <input
                        type="hidden"
                        id="newTaskStatus"
                    >


                    <div class="mb-3">

                        <label class="form-label">
                            Title
                        </label>

                        <input
                            class="form-control"
                            id="newTaskTitle"
                            required
                        >

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea
                            class="form-control"
                            id="newTaskDescription"
                        ></textarea>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Priority
                        </label>

                        <select
                            class="form-select"
                            id="newTaskPriority"
                        >

                            <option value="LOW">
                                LOW
                            </option>

                            <option
                                value="MEDIUM"
                                selected
                            >
                                MEDIUM
                            </option>

                            <option value="HIGH">
                                HIGH
                            </option>

                            <option value="URGENT">
                                URGENT
                            </option>

                        </select>

                    </div>


                </div>


                <div class="modal-footer">


                    <button
                        class="btn btn-secondary"
                        type="button"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        id="createTaskButton"
                        class="btn btn-primary"
                        type="submit"
                    >
                        Create Task
                    </button>


                </div>


            </form>

        </div>

    </div>

</div>


<!-- ============================================
     TOAST CONTAINER
============================================= -->
<!--
